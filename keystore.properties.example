# Copie para keystore.properties e ajuste. O arquivo real não é versionado.
#
# Gerar uma keystore nova:
#   keytool -genkeypair -v -keystore keystore/privatephone.jks -alias privatephone \
#     -keyalg RSA -keysize 2048 -validity 10950
#
storeFile=keystore/privatephone.jks
storePassword=TROQUE_AQUI
keyAlias=privatephone
keyPassword=TROQUE_AQUI
